---
//Navbar.astro
const enlaces = [
    { nombre: "Inicio 🍮", ruta: "/" },
    { nombre: "Sobre Mí 🐾", ruta: "/sobre-mi" },
    { nombre: "Blog ☕", ruta: "/blog" },
    { nombre: "Contacto ✉️", ruta: "/contacto" },
];
---

<nav>
    <div>
        <!-- Logo temático de Pompompurin -->
        <a href="/">🍮</a>
    </div>

    <ul>
        {
            enlaces.map((enlace) => (
                <li>
                    <a href={enlace.ruta}>{enlace.nombre}</a>
                </li>
            ))
        }
    </ul>
</nav>
