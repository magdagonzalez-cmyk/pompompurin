---
// Footer.astro
const anoActual = new Date().getFullYear();
const miNombre = "Tu Nombre"; // Cambia esto por tu nombre real
---

<footer class="footer">
    <div class="contenido">
        <p>&copy; {anoActual} {miNombre}. Todos los derechos reservados.</p>

        <div class="redes">
            <a
                href="https://twitter.com"
                target="_blank"
                rel="noopener noreferrer">Twitter</a
            >
            <a
                href="https://github.com"
                target="_blank"
                rel="noopener noreferrer">GitHub</a
            >
            <a
                href="https://linkedin.com"
                target="_blank"
                rel="noopener noreferrer">LinkedIn</a
            >
        </div>
    </div>
</footer>

<style>
    .footer {
        background-color: #11111b;
        color: #a6adc8;
        padding: 2rem 1rem;
        text-align: center;
        margin-top: auto; /* Ayuda a empujarlo hacia abajo */
        border-top: 1px solid #313244;
    }

    .contenido {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: center;
    }

    .redes {
        display: flex;
        gap: 1rem;
    }

    .redes a {
        color: #89b4fa;
        text-decoration: none;
        font-size: 0.9rem;
    }

    .redes a:hover {
        text-decoration: underline;
    }
</style>
